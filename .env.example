# Copy this file to ".env" and fill it in. Never share the .env file.

# Required: the password you use to sign in at /admin (at least 8 characters, use a long one)
ADMIN_PASSWORD=change-this-to-a-long-password

# Port the website listens on (hosting services usually set this for you)
PORT=3000

# Set to 1 when the site runs behind a proxy or hosting platform (Render, Railway, Nginx, Cloudflare)
# so that rate limiting sees each visitor's real IP address.
TRUST_PROXY=0

# Where the database and uploaded product photos are stored. Must be on a persistent disk in production.
# DATA_DIR=/var/data

# Set to 0 to start with an empty catalog instead of the 12 sample products.
SEED_SAMPLES=1
